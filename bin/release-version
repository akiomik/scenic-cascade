#!/usr/bin/env bash
set -euo pipefail

if [[ ! "${RELEASE_TAG:-}" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  printf 'Invalid release tag: %s\n' "${RELEASE_TAG:-}" >&2
  exit 1
fi

tag_version=${RELEASE_TAG#v}
script_dir=$(cd "$(dirname "$0")" && pwd)
gem_version=$(ruby -r "$script_dir/../lib/scenic/cascade/version" -e 'print Scenic::Cascade::VERSION')

if [[ "$tag_version" != "$gem_version" ]]; then
  printf 'Release tag %s does not match gem version %s\n' "$RELEASE_TAG" "$gem_version" >&2
  exit 1
fi

printf 'version=%s\n' "$tag_version" >> "$GITHUB_OUTPUT"
