# frozen_string_literal: true

class <%= migration_class_name %> < <%= activerecord_migration_class %>
  <%- if dependents.any? || plural_name.include?('.') -%>
  class ExactViewName < String
    alias table_name to_s
  end

  <%- end -%>
  <%- target_name = plural_name.include?('.') ? "ExactViewName.new(#{plural_name.inspect})" : formatted_plural_name -%>
  <%- update_method = options[:replace] ? 'replace_view' : 'update_view' -%>
  <%- materialized_flags = [] -%>
  <%- materialized_flags << 'no_data: true' if options[:no_data] -%>
  <%- materialized_flags << 'side_by_side: true' if options[:side_by_side] -%>
  <%- materialized_options = materialized_flags.empty? ? 'true' : "{ #{materialized_flags.join(', ')} }" -%>
  def change
  <%- dependents.reverse_each do |dep| -%>
  <%- if dep.materialized? -%>
    reversible do |direction|
      direction.up { capture_dependent_indexes(<%= dep.database_name.inspect %>) }
      direction.down { restore_dependent_indexes(<%= dep.database_name.inspect %>) }
    end
  <%- end -%>
  <%- if dep.database_name == dep.name -%>
    drop_view ExactViewName.new(<%= dep.database_name.inspect %>),
              revert_to_version: <%= dep.version %>,
              materialized: <%= dep.materialized? %>
  <%- else -%>
    reversible do |direction|
      direction.up do
        drop_view ExactViewName.new(<%= dep.database_name.inspect %>), materialized: <%= dep.materialized? %>
      end
      direction.down do
        create_view ExactViewName.new(<%= dep.database_name.inspect %>),
                    sql_definition: Scenic::Definition.new(<%= dep.name.inspect %>, <%= dep.version %>).to_sql,
                    materialized: <%= dep.materialized? %>
      end
    end
  <%- end -%>
  <%- end -%>

  <%- if materialized? -%>
    <%= update_method %> <%= target_name %>,
      version: <%= version %>,
      revert_to_version: <%= previous_version %>,
      materialized: <%= materialized_options %>
  <%- else -%>
    <%= update_method %> <%= target_name %>, version: <%= version %>, revert_to_version: <%= previous_version %>
  <%- end -%>

  <%- dependents.each do |dep| -%>
  <%- if dep.database_name == dep.name -%>
    create_view ExactViewName.new(<%= dep.database_name.inspect %>),
                version: <%= dep.version %>,
                materialized: <%= dep.materialized? %>
  <%- else -%>
    reversible do |direction|
      direction.up do
        create_view ExactViewName.new(<%= dep.database_name.inspect %>),
                    sql_definition: Scenic::Definition.new(<%= dep.name.inspect %>, <%= dep.version %>).to_sql,
                    materialized: <%= dep.materialized? %>
      end
      direction.down do
        drop_view ExactViewName.new(<%= dep.database_name.inspect %>), materialized: <%= dep.materialized? %>
      end
    end
  <%- end -%>
  <%- if dep.materialized? -%>
    reversible do |direction|
      direction.up { restore_dependent_indexes(<%= dep.database_name.inspect %>) }
      direction.down { capture_dependent_indexes(<%= dep.database_name.inspect %>) }
    end
  <%- end -%>
  <%- end -%>
  end

  <%- if dependents.any?(&:materialized?) -%>
  private

  def capture_dependent_indexes(name)
    @dependent_indexes ||= {}
    @dependent_indexes[name] = connection.select_all(<<~SQL).to_a
      SELECT pg_get_indexdef(i.indexrelid) AS definition,
             format('%I.%I', ns.nspname, idx.relname) AS index_name,
             obj_description(i.indexrelid, 'pg_class') AS comment,
             attr.attnum AS statistics_column,
             attr.attstattarget AS statistics_target
      FROM pg_index AS i
      JOIN pg_class AS idx ON idx.oid = i.indexrelid
      JOIN pg_namespace AS ns ON ns.oid = idx.relnamespace
      LEFT JOIN pg_attribute AS attr
        ON attr.attrelid = i.indexrelid AND attr.attnum > 0 AND attr.attstattarget >= 0
      WHERE i.indrelid = to_regclass(#{connection.quote(name)})
      ORDER BY i.indexrelid, attr.attnum
    SQL
  end

  def restore_dependent_indexes(name)
    @dependent_indexes.fetch(name).group_by { |row| row.fetch('index_name') }.each do |index_name, rows|
      execute(rows.first.fetch('definition'))
      rows.each do |row|
        next unless row['statistics_column']

        execute("ALTER INDEX #{index_name} ALTER COLUMN #{Integer(row.fetch('statistics_column'))} " \
                "SET STATISTICS #{Integer(row.fetch('statistics_target'))}")
      end

      comment = rows.first['comment']
      execute("COMMENT ON INDEX #{index_name} IS #{connection.quote(comment)}") unless comment.nil?
    end
  end
  <%- end -%>
end
