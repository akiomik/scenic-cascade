module Scenic
  module Generators
    module View
      class CascadeGenerator < Scenic::Generators::ViewGenerator
        @dependents: Array[Scenic::Cascade::ViewWithVersion]?

        def create_view_definition: -> void
        def create_migration_file: -> void

        private

        def dependents: -> Array[Scenic::Cascade::ViewWithVersion]
        def view_with_version_for: (Scenic::Cascade::Dependency) -> Scenic::Cascade::ViewWithVersion
        def database_view_name: -> String
        def definition_name_for: (String) -> String
        def bare_name_resolves_to_public?: (String) -> bool
        def qualified_name: (String) -> String
      end
    end
  end
end
