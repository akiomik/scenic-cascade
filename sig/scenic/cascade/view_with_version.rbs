module Scenic
  module Cascade
    interface _ViewWithVersionLike
      def name: -> String
      def version: -> Integer
      def materialized?: -> bool
    end

    class ViewWithVersion < Scenic::Cascade::View
      attr_reader version: Integer
      attr_reader database_name: String

      def initialize: (name: String, version: Integer, materialized: bool, ?database_name: String) -> void

      def ==: (_ViewWithVersionLike) -> bool

      private

      def formatted_version: -> String
    end
  end
end
